{
  "name": "dsh-plugin-github-manager",
  "version": "0.1.0",
  "description": "Kompletter GitHub-Manager für DSH Desktop – Multi-Account, Repos/Issues/PRs/Actions/Notifications, pro-Account Dashboard, Settings & 25 Agent-Tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "dsh-desktop",
    "multi-account",
    "dashboard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jahdaganj04ki-a11y/dshgithubmanagement.git"
  },
  "homepage": "https://github.com/jahdaganj04ki-a11y/dshgithubmanagement#readme",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port $PORT",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "build:v": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port $PORT",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || 0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2 || 0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2 || 0.1.5-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lightningcss": "^1.30.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "vite": "^6.2.5"
  }
}
